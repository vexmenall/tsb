local renderers = {} -- everything that needs redrawing when a setting changes
local function renderAll()
	for _, fn in ipairs(renderers) do fn() end
end

local function updateCircle()
	local d = settings.fov * 2
	circle.Size = UDim2.fromOffset(d, d)
	circle.Visible = settings.enabled and settings.showCircle
end

local function updateStatus()
	status.Text = "[" .. TOGGLE_KEY.Name .. "] Aim Lock: " .. (settings.enabled and "ON" or "OFF")
	status.TextColor3 = settings.enabled and GREEN or SILVER
end

local order = 0
local function makeSlider(text, min, max, key, suffix)
	order += 1
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 52)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = content

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(0.6, 0, 0, 20)
	nameLabel.Text = text
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = row
	styleText(nameLabel, 17)

	local valueLabel = Instance.new("TextLabel")
	valueLabel.BackgroundTransparency = 1
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, 0, 0, 0)
	valueLabel.Size = UDim2.new(0.4, 0, 0, 20)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = row
	styleText(valueLabel, 17, GOLD)

	local track = Instance.new("Frame")
	track.Position = UDim2.new(0, 0, 0, 32)
	track.Size = UDim2.new(1, 0, 0, 10)
	track.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	track.BorderSizePixel = 0
	track.Parent = row
	addCorner(track, 5)
	addStroke(track, 2, Enum.ApplyStrokeMode.Border)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = WHITE
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = track
	addCorner(fill, 5)
	setGradient(fill, GOLD, GOLD_DARK)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(18, 18)
	knob.BackgroundColor3 = WHITE
	knob.BorderSizePixel = 0
	knob.ZIndex = 3
	knob.Parent = track
	addCorner(knob, 9)
	addStroke(knob, 2, Enum.ApplyStrokeMode.Border)

	local hit = Instance.new("TextButton") -- big invisible grab area
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Position = UDim2.new(0, -8, 0, 22)
	hit.Size = UDim2.new(1, 16, 0, 30)
	hit.ZIndex = 4
	hit.Parent = row

	local function render()
		local rel = (settings[key] - min) / (max - min)
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		valueLabel.Text = tostring(settings[key]) .. (suffix or "")
	end
	table.insert(renderers, render)

	local dragging = false
	local function setFromX(x)
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		settings[key] = math.floor(min + rel * (max - min) + 0.5)
		render()
		updateCircle()
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	render()
end

local function makeToggle(text, key)
	order += 1
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 34)
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.BackgroundColor3 = WHITE
	btn.BorderSizePixel = 0
	btn.Parent = content
	addCorner(btn, 10)
	addStroke(btn, 2, Enum.ApplyStrokeMode.Border)
	local label = newLabel(btn, "", 17)

	local function render()
		label.Text = text .. ": " .. (settings[key] and "ON" or "OFF")
		if settings[key] then
			setGradient(btn, Color3.fromRGB(90, 200, 120), Color3.fromRGB(45, 130, 75))
		else
			setGradient(btn, KEY_TOP, KEY_BOTTOM)
		end
	end
	table.insert(renderers, render)

	btn.Activated:Connect(function()
		settings[key] = not settings[key]
		render()
		updateCircle()
		updateStatus()
	end)
	render()
end

makeToggle("Aim Lock", "enabled")
makeSlider("FOV size", FOV_MIN, FOV_MAX, "fov", " px")
