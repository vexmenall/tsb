makeToggle("Show FOV circle", "showCircle")
makeToggle("Wall check", "wallCheck")
makeToggle("Team check", "teamCheck")

-- ====================================================================
-- ====== MENU OPEN/CLOSE (frees the mouse while it's open) ===========
-- ====================================================================
local menuOpen = false
local saved = nil

local function setMenu(open)
	if open == menuOpen then return end
	menuOpen = open
	menu.Visible = open

	if open then
		saved = {
			cameraMode = player.CameraMode,
			behavior = UserInputService.MouseBehavior,
			icon = UserInputService.MouseIconEnabled,
		}
		-- a first-person camera script would keep re-locking the mouse, so pause it while the menu is open
		local ps = player:FindFirstChild("PlayerScripts")
		local fp = ps and ps:FindFirstChild("FirstPersonCamera")
		if fp and fp:IsA("LocalScript") and not fp.Disabled then
			saved.fp = fp
			fp.Disabled = true
		end
		pcall(function() RunService:UnbindFromRenderStep("AimLockMouse") end)
		RunService:BindToRenderStep("AimLockMouse", Enum.RenderPriority.Camera.Value + 10, function()
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end)
		pop(menu, 0.85)
		renderAll()
	else
		pcall(function() RunService:UnbindFromRenderStep("AimLockMouse") end)
		if saved then
			if saved.fp then saved.fp.Disabled = false end
			player.CameraMode = saved.cameraMode
			UserInputService.MouseBehavior = saved.behavior
			UserInputService.MouseIconEnabled = saved.icon
			saved = nil
		end
	end
end

-- ====================================================================
-- ====== TARGETING ===================================================
-- ====================================================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- returns the part to aim at and how far (pixels) it is from the crosshair, or nil if it can't be targeted
local function evaluate(plr, cam)
	if plr == player then return nil end
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	if settings.teamCheck and plr.Team ~= nil and plr.Team == player.Team then return nil end

	local part = char:FindFirstChild(TARGET_PART) or char:FindFirstChild("HumanoidRootPart")
	if not part then return nil end

	local v, onScreen = cam:WorldToViewportPoint(part.Position)
	if not onScreen then return nil end
	local d = (Vector2.new(v.X, v.Y) - cam.ViewportSize / 2).Magnitude

	if settings.wallCheck then
		rayParams.FilterDescendantsInstances = { player.Character }
		local origin = cam.CFrame.Position
		local res = workspace:Raycast(origin, part.Position - origin, rayParams)
		if res and not res.Instance:IsDescendantOf(char) then return nil end
	end
	return part, d
end

local locked = nil -- the player we're currently locked onto

RunService:BindToRenderStep("AimLock", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	local holding = UserInputService:IsMouseButtonPressed(LOCK_BUTTON)

	if not settings.enabled or menuOpen or not holding or not cam then
		locked = nil
		circleStroke.Color = WHITE
		return
	end

	local part = nil
	if locked then -- stay on the same target while you hold the button, as long as you can still see them
		part = evaluate(locked, cam)
		if not part then locked = nil end
	end
	if not locked then -- otherwise pick whoever is closest to the crosshair inside the circle
		local bestD = settings.fov
		for _, plr in ipairs(Players:GetPlayers()) do
			local p, d = evaluate(plr, cam)
			if p and d <= bestD then
				bestD = d
				locked, part = plr, p
			end
		end
	end

	circleStroke.Color = locked and GOLD or WHITE
	if part then
		local goal = CFrame.lookAt(cam.CFrame.Position, part.Position)
		local speed = 2 + settings.strength * 0.3 -- strength 100 = near instant
		cam.CFrame = cam.CFrame:Lerp(goal, 1 - math.exp(-speed * dt))
	end
end)

-- ====================================================================
-- ====== INPUT =======================================================
-- ====================================================================
UserInputService.InputBegan:Connect(function(input)
	if UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode == TOGGLE_KEY then
		settings.enabled = not settings.enabled
		updateStatus()
		updateCircle()
		renderAll()
		pop(status, 0.8)
	elseif input.KeyCode == MENU_KEY then
		setMenu(not menuOpen)
	end
end)

player.CharacterRemoving:Connect(function()
	locked = nil
end)

updateStatus()
updateCircle()
