-- AimLock (LocalScript in StarterPlayer > StarterPlayerScripts)
-- Lock-on / aim assist for your game.
--   [N]  turn it on/off (small status text, bottom left)
--   Hold RIGHT CLICK  -> the camera locks onto the player closest to your crosshair, inside the FOV circle
--   [M]  open the menu: shrink/grow the FOV circle, lock strength, show the circle, wall check, team check
-- It only moves YOUR camera. Nothing is sent to the server.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ====================================================================
-- ====== CONFIG (edit these) =========================================
-- ====================================================================
local TOGGLE_KEY = Enum.KeyCode.N              -- turns the aim lock on/off
local MENU_KEY = Enum.KeyCode.M                -- opens/closes the settings menu
local LOCK_BUTTON = Enum.UserInputType.MouseButton2 -- hold this to lock on (right click)
local TARGET_PART = "Head"                     -- "Head" or "HumanoidRootPart" (chest)

local FOV_MIN, FOV_MAX = 30, 500               -- FOV circle radius limits, in pixels

-- starting values (you can change them in the menu while playing)
local settings = {
	enabled = false,
	fov = 150,          -- radius of the FOV circle (pixels). Smaller = harder to lock
	strength = 70,      -- 1-100. How hard the camera snaps onto the target
	showCircle = true,  -- draw the FOV circle while the aim lock is on
	wallCheck = true,   -- only lock onto players you can actually see
	teamCheck = true,   -- ignore players on your own team
}

-- ====================================================================
-- ====== STYLE (same look as the rest of your game) ==================
-- ====================================================================
local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local EDGE = Color3.fromRGB(4, 4, 7)
local SILVER = Color3.fromRGB(195, 195, 206)
local KEY_TOP = Color3.fromRGB(58, 58, 70)
local KEY_BOTTOM = Color3.fromRGB(30, 30, 40)
local GOLD = Color3.fromRGB(255, 214, 90)
local GOLD_DARK = Color3.fromRGB(200, 140, 30)
local GREEN = Color3.fromRGB(100, 230, 130)
local POP = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function addStroke(inst, thickness, mode, color)
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Contextual
	s.Color = color or EDGE
	s.Thickness = thickness
	s.Parent = inst
	return s
end

local function addCorner(inst, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = inst
	return c
end

local function styleText(label, size, color)
	label.Font = FONT
	label.TextSize = size
	label.TextColor3 = color or WHITE
	addStroke(label, math.max(1.5, size / 9), Enum.ApplyStrokeMode.Contextual)
end

local function setGradient(frame, top, bottom)
	local g = frame:FindFirstChild("Fill")
	if not g then
		g = Instance.new("UIGradient")
		g.Name = "Fill"
		g.Rotation = 90
		g.Parent = frame
	end
	g.Color = ColorSequence.new(top, bottom)
end

local function pop(obj, from)
	local s = obj:FindFirstChild("PopScale")
	if not s then
		s = Instance.new("UIScale")
		s.Name = "PopScale"
		s.Parent = obj
	end
	s.Scale = from or 0.6
	TweenService:Create(s, POP, { Scale = 1 }):Play()
end

local function newLabel(parent, text, size, color, xAlign)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.Size = UDim2.fromScale(1, 1)
	l.TextXAlignment = xAlign or Enum.TextXAlignment.Center
	l.Parent = parent
	styleText(l, size, color)
	return l
end

