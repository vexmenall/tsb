RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	dt = math.min(dt, 0.1)

	-- main panel: NO floating, just smooth drag easing + animated border/background
	if panel.Visible then
		local a = 1 - math.exp(-dt * 22) -- frame-rate independent easing
		panelPos = panelPos:Lerp(panelTarget, a)
		if (panelPos - panelTarget).Magnitude < 0.05 then panelPos = panelTarget end
		panel.Position = UDim2.new(0.5, panelPos.X, 0.5, panelPos.Y)

		borderGrad.Rotation = (t * 60) % 360
		panelBg.Offset = Vector2.new(math.sin(t * 0.8) * 0.25, 0)
		subtitle.TextColor3 = RED_BRIGHT:Lerp(Color3.fromRGB(255, 200, 215), (math.sin(t * 2.2) + 1) / 2)
	end

	for _, fx in ipairs(fxList) do updateFX(fx, dt) end

	-- only the keybind hint box floats: one slow sine so the motion is even
	local bob = math.sin(t * 1.5) * 4
	hintBox.Position = HINT_BASE + UDim2.fromOffset(0, bob)
	hintStrokeGrad.Rotation = (t * 60) % 360
	hintBg.Offset = Vector2.new(math.sin(t * 0.8) * 0.25, 0)
	menuChip.TextColor3 = RED_BRIGHT:Lerp(Color3.fromRGB(255, 200, 215), (math.sin(t * 2.2) + 1) / 2)

	for key, data in pairs(chipLabels) do
		local v = stats[key]
		if v ~= chipLast[key] then
			chipLast[key] = v
			data.num.Text = tostring(v)
			popScale(data.chip, 0.8)
		end
	end
end)

