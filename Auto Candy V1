-- ====== CANDY =======================================================
-- ====================================================================
local candyAttempts = setmetatable({}, { __mode = "k" })
local currentFight = nil
local dumpedCandy = false

-- still sitting in the candy folder? (a picked up Tool moves to your Backpack, so Parent isn't nil)
local function candyStillThere(candy)
	local p = candy.Parent
	return p ~= nil and p.Name == C.CANDY_FOLDER
end

-- one-time debug dump so you can see exactly what a "Candy" is
local function dumpCandy(candy)
	if dumpedCandy then return end
	dumpedCandy = true
	log("INFO", "Candy object info:", candy.ClassName, "|", candy:GetFullName())
	local kids = {}
	for i, ch in ipairs(candy:GetChildren()) do
		if i > 10 then table.insert(kids, "...") break end
		table.insert(kids, ch.Name .. "(" .. ch.ClassName .. ")")
	end
	log("INFO", "Candy children:", #kids > 0 and table.concat(kids, ", ") or "none")
	for k, v in pairs(candy:GetAttributes()) do
		log("INFO", "Candy attribute:", k, "=", tostring(v), "(" .. typeof(v) .. ")")
	end
end

local warnedNoPos = setmetatable({}, { __mode = "k" })

-- one saved position per Candy object (remembers the last good one)
local candyPosCache = setmetatable({}, { __mode = "k" })
local candyPosSource = setmetatable({}, { __mode = "k" })

local function resolvePos(inst, depth)
	depth = depth or 0
	if depth > 4 or not inst then return nil end

	-- 1. real parts
	if inst:IsA("BasePart") then return inst.Position, "BasePart" end
	if inst:IsA("Tool") then
		local h = inst:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then return h.Position, "Tool.Handle" end
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and cf then return cf.Position, "Model pivot" end
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	if part then return part.Position, "child part " .. part.Name end

	-- 2. Vector3 / CFrame attributes
	for _, n in ipairs(C.CANDY_POS_ATTRS) do
		local v = vecFromValue(inst:GetAttribute(n))
		if v then return v, "attribute " .. n end
	end
	for k, v in pairs(inst:GetAttributes()) do
		if not C.CANDY_IGNORE_ATTRS[k] then
			local vec = vecFromValue(v)
			if vec then return vec, "attribute " .. k end
		end
	end

	-- 3. separate X / Y / Z number attributes
	local ax, ay, az = inst:GetAttribute("X"), inst:GetAttribute("Y"), inst:GetAttribute("Z")
	if type(ax) == "number" and type(ay) == "number" and type(az) == "number" then
		return Vector3.new(ax, ay, az), "attributes X/Y/Z"
	end

	-- 4. value objects inside it
	local nx, ny, nz
	for _, ch in ipairs(inst:GetChildren()) do
		if ch:IsA("Vector3Value") then return ch.Value, "Vector3Value " .. ch.Name end
		if ch:IsA("CFrameValue") then return ch.Value.Position, "CFrameValue " .. ch.Name end
		if ch:IsA("ObjectValue") and ch.Value then
			local p, src = resolvePos(ch.Value, depth + 1)
			if p then return p, "ObjectValue " .. ch.Name .. " -> " .. src end
		end
		if ch:IsA("NumberValue") or ch:IsA("IntValue") then
			local n = string.upper(ch.Name)
			if n == "X" then nx = ch.Value elseif n == "Y" then ny = ch.Value elseif n == "Z" then nz = ch.Value end
		end
	end
	if nx and ny and nz then return Vector3.new(nx, ny, nz), "NumberValues X/Y/Z" end

	return nil
end

local function candyPoint(candy)
	local p, src = resolvePos(candy)
	if p then
		candyPosCache[candy] = p
		candyPosSource[candy] = src
		return p
	end
	return candyPosCache[candy] -- fall back to the last known good spot
end

local function findCandy()
	local f = Workspace:FindFirstChild(C.CANDY_FOLDER)
	if not f then return nil end
	local _, _, r = getChar()
	if not r then return nil end
	local best, bestD = nil, math.huge
	for _, ch in ipairs(f:GetChildren()) do
		if ch.Name == C.CANDY_NAME and (candyAttempts[ch] or 0) < C.CANDY_MAX_ATTEMPTS then
			local p = candyPoint(ch)
			if p then
				local d = (p - r.Position).Magnitude
				if d < bestD then best, bestD = ch, d end
			elseif not warnedNoPos[ch] then
				warnedNoPos[ch] = true
				log("WARN", "A candy has no readable position:", ch.ClassName, ch:GetFullName())
				dumpCandy(ch)
			end
		end
	end
	return best
end

-- the part you'd actually touch to pick the candy up (for firetouchinterest, if your executor has it)
local function candyTouchPart(candy)
	if candy:IsA("BasePart") then return candy end
	if candy:IsA("Tool") then
		local h = candy:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then return h end
	end
	return candy:FindFirstChildWhichIsA("BasePart", true)
end

-- teleports onto one candy and checks whether it got picked up
local function collectCandy(candy)
	if not candy or not candy.Parent then return end

	candyAttempts[candy] = (candyAttempts[candy] or 0) + 1
	local attempt = candyAttempts[candy]

	local p = candyPoint(candy)
	if not p then
		candyAttempts[candy] = C.CANDY_MAX_ATTEMPTS
		log("WARN", "Candy has no position, skipping:", candy:GetFullName())
		return
	end

	-- timing attributes (server time): don't chase expired candy, wait for it to land first
	local born, fly, expire = candy:GetAttribute("Born"), candy:GetAttribute("Fly"), candy:GetAttribute("Expire")
	local now = Workspace:GetServerTimeNow()
	if type(expire) == "number" and now >= expire - 0.3 then
		candyAttempts[candy] = C.CANDY_MAX_ATTEMPTS
		log("DBG", "Candy about to expire, skipping")
		return
	end
	if type(born) == "number" and type(fly) == "number" then
		local landAt = born + fly
		while Workspace:GetServerTimeNow() < landAt do
			task.wait()
			if not active("candy") or not candy.Parent then return end
		end
	end

	log("DBG", string.format("Candy attempt %d/%d at %s via %s", attempt, C.CANDY_MAX_ATTEMPTS,
		tostring(p), candyPosSource[candy] or "cache"))

	local target = CFrame.new(p + Vector3.new(0, C.CANDY_Y_OFFSET, 0))
	if not teleportTo(target, "candy") then
		-- paused / toggled off: don't burn an attempt
		candyAttempts[candy] = math.max(0, attempt - 1)
		return
	end

	-- optional extra: fake a touch if the executor supports it
	if ext_firetouch then
		local _, _, r = getChar()
		local part = candyTouchPart(candy)
		if r and part then
			pcall(ext_firetouch, r, part, 0)
			pcall(ext_firetouch, r, part, 1)
		end
	end

	local t0 = os.clock()
	while os.clock() - t0 < C.CANDY_CONFIRM do
		task.wait()
		if not active("candy") then return end
		if not candyStillThere(candy) then break end
	end

	if not candyStillThere(candy) then
		stats.candy += 1
		candyAttempts[candy] = nil
		log("OK", "Candy collected (total " .. stats.candy .. ")")
	else
		log("DBG", "Candy still there after attempt " .. attempt)
	end
end

-- logs every candy and where its position came from
local function scanCandy()
	local f = Workspace:FindFirstChild(C.CANDY_FOLDER)
	if not f then return end
	local ok, bad = 0, 0
	for _, ch in ipairs(f:GetChildren()) do
		if ch.Name == C.CANDY_NAME then
			local p = candyPoint(ch)
			if p then
				ok += 1
				log("DBG", ch.ClassName, "->", tostring(p), "via", candyPosSource[ch] or "cache")
			else
				bad += 1
				log("WARN", "No position for", ch.ClassName, ch:GetFullName())
			end
		end
	end
	log("INFO", "Candy scan:", ok, "have a position,", bad, "don't")
end

local function hookCandyFolder(folder)
	log("OK", "Hooked candy folder '" .. folder.Name .. "' (" .. #folder:GetChildren() .. " children right now)")
	folder.ChildAdded:Connect(function(ch)
		log("INFO", "Candy spawned:", ch.Name, ch.ClassName)
		task.defer(function()
			local fight = currentFight
			if fight and fight.kind == "pinata" then
				local p = candyPoint(ch)
				if p and (p - fight.pos).Magnitude <= C.POP_DETECT_RADIUS then
					fight.popped = true
					log("INFO", "Pinata pop detected via candy spawn near target")
				end
			end
		end)
	end)
	folder.ChildRemoved:Connect(function(ch)
		log("DBG", "Candy removed:", ch.Name)
	end)
end

-- ====================================================================
-- ====== PINATA / ZOMBIE FIGHTING ====================================
-- ====================================================================
local blacklist = setmetatable({}, { __mode = "k" })

local function findTarget()
	local live = Workspace:FindFirstChild(C.LIVE_FOLDER)
	if not live then return nil end
	local _, _, r = getChar()
	if not r then return nil end
	local best, bestKind, bestD = nil, nil, math.huge
	for _, m in ipairs(live:GetChildren()) do
		if (blacklist[m] or 0) < os.clock() then
			local kind = nil
			if settings.pinata and nameMatches(m.Name, C.PINATA_MATCH) then
				kind = "pinata"
			elseif settings.zombie and nameMatches(m.Name, C.ZOMBIE_MATCH) then
				kind = "zombie"
			end
			if kind then
				local hum = m:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health > 0 then
					local p = getPos(m)
					if p then
						local d = (p - r.Position).Magnitude
						if d < bestD then best, bestKind, bestD = m, kind, d end
					end
				end
			end
		end
	end
	return best, bestKind
end

-- keeps you at STICK_DISTANCE from the target (on whatever side you're already on) and facing it.
-- Only moves you when you drift out of range, so you never get shoved into it / fling it.
local function stickTo(p)
	local c, _, r = getChar()
	if not c then return end

	local mine = r.Position
	local flat = Vector3.new(mine.X - p.X, 0, mine.Z - p.Z)
	local dist = flat.Magnitude
	local dir = dist > 0.1 and flat.Unit or Vector3.new(0, 0, 1)

	local inRange = math.abs(dist - C.STICK_DISTANCE) <= C.STICK_TOLERANCE and math.abs(mine.Y - p.Y) <= 4
	local pos = mine
	if not inRange then
		pos = Vector3.new(p.X, p.Y, p.Z) + dir * C.STICK_DISTANCE
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
	end
	c:PivotTo(CFrame.lookAt(pos, Vector3.new(p.X, pos.Y, p.Z)))
end

local function fightTarget(t, kind)
	local label = kind .. " '" .. t.Name .. "'"
	log("INFO", "FIGHT start:", label)
	local fight = { kind = kind, pos = getPos(t) or Vector3.zero, popped = false }
	currentFight = fight
	local startT, lastLog = os.clock(), 0
	local hum = t:FindFirstChildOfClass("Humanoid")
	local broke, reason = false, "?"

	while true do
		task.wait()
		if not active(kind) then reason = "toggled off / paused" break end
		if not t.Parent then broke, reason = true, "removed from Live" break end
		if hum and hum.Health <= 0 then broke, reason = true, "health reached 0" break end
		if kind == "pinata" and fight.popped then broke, reason = true, "candy spawned nearby" break end
		if os.clock() - startT > C.FIGHT_TIMEOUT then
			reason = "timeout"
			blacklist[t] = os.clock() + 30
			log("WARN", "FIGHT timeout on", label, "- blacklisting for 30s")
			break
		end

		local c, h = getChar()
		if not c or h.Health <= 0 then reason = "you died" break end

		if ragdollReason(c, h) then
			-- wait until you're up again; only gives up if toggled off / paused
			if not waitReady(C.RAGDOLL_TIMEOUT, kind) then reason = "toggled off / paused" break end
		else
			local p = getPos(t)
			if p then
				fight.pos = p
				stickTo(p)
			end
			attack()
			if os.clock() - lastLog >= C.FIGHT_LOG_INTERVAL then
				lastLog = os.clock()
				log("DBG", string.format("fighting %s (%.1fs) hp=%s", label, os.clock() - startT,
					hum and string.format("%.0f/%.0f", hum.Health, hum.MaxHealth) or "n/a"))
			end
		end
	end
	currentFight = nil

	if t.Parent then blacklist[t] = os.clock() + C.POST_BREAK_BLACKLIST end
	log("INFO", string.format("FIGHT end: %s - %s (%.1fs)", label, reason, os.clock() - startT))

	if broke then
		if kind == "pinata" then stats.pinatas += 1 else stats.zombies += 1 end
		log("OK", label .. " broke! Waiting for candy to spawn...")
		local t0 = os.clock()
		while os.clock() - t0 < C.CANDY_WAIT and not findCandy() do task.wait() end
		if findCandy() then
			log("INFO", string.format("Candy appeared %.2fs after break", os.clock() - t0))
		else
			log("WARN", "No candy appeared within " .. C.CANDY_WAIT .. "s after break")
		end
	end
end

-- ====================================================================
-- ====== TRICK OR TREAT ==============================================
-- ====================================================================
local treeCooldown = setmetatable({}, { __mode = "k" })
local lastTreeEnd = 0 -- when the last tree finished (used for the gap between trees)

local function nextTree()
	local f = Workspace:FindFirstChild(C.TREE_FOLDER)
	if not f then return nil end
	local _, _, r = getChar()
	if not r then return nil end
	local best, bestPrompt, bestD = nil, nil, math.huge
	for _, t in ipairs(f:GetChildren()) do
		if t.Name == C.TREE_NAME and (treeCooldown[t] or 0) < os.clock() then
			local prompt = t:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt and prompt.Enabled then
				local p = getPos(t)
				if p then
					local d = (p - r.Position).Magnitude
					if d < bestD then best, bestPrompt, bestD = t, prompt, d end
				end
			end
		end
	end
	return best, bestPrompt
end

local function promptPos(prompt, tree)
	local par = prompt.Parent
	if par and par:IsA("BasePart") then return par.Position end
	if par and par:IsA("Attachment") then return par.WorldPosition end
	return getPos(tree)
end

local function sleepChecked(seconds, feature, candyInterrupts)
	local t0 = os.clock()
	while os.clock() - t0 < seconds do
		task.wait()
		if not active(feature) then return "disabled" end
		if candyInterrupts and settings.candy and findCandy() then return "candy" end
	end
	return nil
end

local function doTree(tree, prompt)
	log("INFO", "TRICK OR TREAT start:", tree:GetFullName(), "hold =", prompt.HoldDuration)
	pcall(function() prompt.RequiresLineOfSight = false end)

	local pos = promptPos(prompt, tree)
	if not pos then log("WARN", "Tree has no position, skipping") treeCooldown[tree] = os.clock() + 10 return end
	local standPos = pos + Vector3.new(0, 0, C.TREE_DIST)
	local standCF = CFrame.lookAt(standPos, Vector3.new(pos.X, standPos.Y, pos.Z))

	local triggered = false
	local conn = prompt.Triggered:Connect(function(who)
		if who == player then triggered = true end
	end)

	local success = false
	local attempt = 0
	while attempt < C.TREE_RETRIES do
		attempt += 1
		if not active("tree") then break end
		log("DBG", "Tree attempt", attempt)
		if not teleportTo(standCF, "tree") then
			task.wait(0.25)
			continue
		end
		task.wait(0.1)

		pcall(prompt.InputHoldBegin, prompt)
		local t0 = os.clock()
		local need = prompt.HoldDuration + C.TREE_HOLD_EXTRA
		local interrupted = nil
		while os.clock() - t0 < need and not triggered do
			task.wait()
			if not active("tree") then interrupted = "disabled" break end
			if not prompt.Enabled then interrupted = "prompt disabled" break end
			if C.CANDY_INTERRUPTS_HOLD and settings.candy and findCandy() then interrupted = "candy" break end
			local c, h, r = getChar()
			if not c then interrupted = "no character" break end
			if ragdollReason(c, h) then interrupted = "ragdoll" break end
			if (r.Position - standPos).Magnitude > 5 then
				c:PivotTo(standCF)
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end
		pcall(prompt.InputHoldEnd, prompt)

		if triggered then
			success = true
			log("INFO", string.format("Prompt triggered after %.2fs", os.clock() - t0))
			break
		elseif interrupted == nil then
			success = true
			log("WARN", "Held full time but Triggered never fired - assuming it worked")
			break
		elseif interrupted == "candy" then
			log("INFO", "Hold interrupted by candy spawn - collecting first, tree stays available")
			conn:Disconnect()
			return
		elseif interrupted == "disabled" then
			break
		elseif interrupted == "ragdoll" then
			-- ragdolls don't use up a retry: wait until you're up, then try again
			log("INFO", "Ragdolled during hold - waiting, then retrying")
			attempt -= 1
			waitReady(C.RAGDOLL_TIMEOUT, "tree")
		else
			log("WARN", "Hold interrupted:", interrupted, "(attempt " .. attempt .. ")")
			task.wait(0.2)
		end
	end
	conn:Disconnect()

	if success then
		stats.trees += 1
		treeCooldown[tree] = os.clock() + C.TREE_COOLDOWN
		log("OK", "Trick or treat done (total " .. stats.trees .. "), waiting " .. C.TREE_ANIM_TIME .. "s for animation")
		local why = sleepChecked(C.TREE_ANIM_TIME, "tree", C.CANDY_INTERRUPTS_ANIM)
		if why then log("INFO", "Animation wait cut short:", why) end
		lastTreeEnd = os.clock()
		log("INFO", "Next tree allowed in " .. C.TREE_GAP .. "s")
	elseif active("tree") then
		treeCooldown[tree] = os.clock() + C.TREE_FAIL_COOLDOWN
		lastTreeEnd = os.clock()
		log("WARN", "Trick or treat failed on this tree, retrying in " .. C.TREE_FAIL_COOLDOWN .. "s")
	end
end

-- ====================================================================
-- ====== MAIN LOOP ===================================================
-- ====================================================================
local lastIdleLog = 0

local function step()
	local c, h = getChar()
	if not c or h.Health <= 0 then return false end

	if settings.candy then
		local candy = findCandy()
		if candy then collectCandy(candy) return true end
	end

	if settings.pinata or settings.zombie then
		local t, kind = findTarget()
		if t then fightTarget(t, kind) return true end
	end

	-- trees wait for the gap since the last one finished (candy / fights still run during the gap)
	if settings.tree and os.clock() - lastTreeEnd >= C.TREE_GAP then
		local tree, prompt = nextTree()
		if tree then doTree(tree, prompt) return true end
	end
	return false
end

task.spawn(function()
	while true do
		task.wait()
		if settings.master and (settings.candy or settings.tree or settings.pinata or settings.zombie) then
			local ok, res = pcall(step)
			if not ok then
				log("ERR", "step() error:", res)
				task.wait(0.5)
			elseif res == false then
				if os.clock() - lastIdleLog > 8 then
					lastIdleLog = os.clock()
					log("DBG", "Idle: nothing to do right now")
				end
				task.wait(0.12)
			end
		else
			task.wait(0.1)
		end
	end
end)

