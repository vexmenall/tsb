local VIM = nil
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local deadMethods = {}
local lastClickMethod, lastKeyMethod = nil, nil
local warnedNoAttack = false

local clickMethods = {
	{ name = "custom", fn = function()
		if not C.CUSTOM_M1 then return false end
		C.CUSTOM_M1()
		return true
	end },
	{ name = "VirtualInputManager", fn = function()
		if not VIM then return false end
		local cam = Workspace.CurrentCamera
		local x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
		VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
		VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
		return true
	end },
	{ name = "Tool:Activate", fn = function()
		local c = player.Character
		local tool = c and c:FindFirstChildOfClass("Tool")
		if not tool then return false end
		tool:Activate()
		return true
	end },
	{ name = "mouse1click", fn = function()
		if not ext_mouse1click then return false end
		ext_mouse1click()
		return true
	end },
}

local function doClick()
	for _, m in ipairs(clickMethods) do
		if not deadMethods[m.name] then
			local ok, res = pcall(m.fn)
			if ok and res then
				if lastClickMethod ~= m.name then
					log("INFO", "M1 attack method in use:", m.name)
					lastClickMethod = m.name
				end
				return true
			elseif not ok then
				deadMethods[m.name] = true
				log("WARN", "M1 method failed and was disabled:", m.name, "-", res)
			end
		end
	end
	if not warnedNoAttack then
		warnedNoAttack = true
		log("ERR", "No M1 method works! Set C.CUSTOM_M1 at the top of the script to your game's attack.")
	end
	return false
end

local function pressCombo(key)
	if C.CUSTOM_COMBO and not deadMethods.customKey then
		local ok, err = pcall(C.CUSTOM_COMBO, key)
		if ok then
			if lastKeyMethod ~= "custom" then log("INFO", "Combo method in use: custom"); lastKeyMethod = "custom" end
			return true
		end
		deadMethods.customKey = true
		log("WARN", "CUSTOM_COMBO failed and was disabled:", err)
	end
	if VIM and not deadMethods.vimKey then
		local ok, err = pcall(function()
			VIM:SendKeyEvent(true, key, false, game)
			task.delay(0.03, function() pcall(function() VIM:SendKeyEvent(false, key, false, game) end) end)
		end)
		if ok then
			if lastKeyMethod ~= "VirtualInputManager" then
				log("INFO", "Combo method in use: VirtualInputManager")
				lastKeyMethod = "VirtualInputManager"
			end
			return true
		end
		deadMethods.vimKey = true
		log("WARN", "VirtualInputManager key press failed and was disabled:", err)
	end
	return false
end

local lastAttack, comboCounter, comboIdx = 0, 0, 1
local function attack()
	local now = os.clock()
	if now - lastAttack < C.ATTACK_INTERVAL then return end
	lastAttack = now
	comboCounter += 1
	if C.USE_COMBOS and comboCounter % C.COMBO_EVERY == 0 then
		local key = C.COMBO_KEYS[comboIdx]
		comboIdx = comboIdx % #C.COMBO_KEYS + 1
		log("DBG", "combo key", key.Name)
		if pressCombo(key) then return end
	end
	doClick()
end

