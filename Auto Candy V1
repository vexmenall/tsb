local function getChar()
	local c = player.Character
	if not c then return nil end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if h and r then return c, h, r end
	return nil
end

local function vecFromValue(v)
	if typeof(v) == "Vector3" then return v end
	if typeof(v) == "CFrame" then return v.Position end
	return nil
end

-- works for Parts, Models, Tools (uses Handle), Configurations (position stored in attributes / values)
local function getPos(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Tool") then
		local h = inst:FindFirstChild("Handle")
		if h and h:IsA("BasePart") then return h.Position end
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and cf then return cf.Position end
	end
	local p = inst:FindFirstChildWhichIsA("BasePart", true)
	if p then return p.Position end

	-- attributes: well-known names first, then any Vector3 / CFrame attribute
	for _, n in ipairs(C.CANDY_POS_ATTRS) do
		local v = vecFromValue(inst:GetAttribute(n))
		if v then return v end
	end
	for _, v in pairs(inst:GetAttributes()) do
		local vec = vecFromValue(v)
		if vec then return vec end
	end

	for _, ch in ipairs(inst:GetChildren()) do
		if ch:IsA("Vector3Value") then return ch.Value end
		if ch:IsA("CFrameValue") then return ch.Value.Position end
	end
	return nil
end

local function nameMatches(name, list)
	local l = string.lower(name)
	for _, p in ipairs(list) do
		if string.find(l, p, 1, true) then return true end
	end
	return false
end

local function active(feature)
	return settings.master and settings[feature]
end

-- ====================================================================
-- ====== RAGDOLL CHECK ===============================================
-- ====================================================================
local BAD_STATES = {
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.GettingUp] = true,
	[Enum.HumanoidStateType.Physics] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Dead] = true,
}

local function ragdollReason(c, h)
	if h.Health <= 0 then return "dead" end
	local st = h:GetState()
	if BAD_STATES[st] then return "state " .. st.Name end
	if h.PlatformStand then return "PlatformStand" end
	for _, n in ipairs(C.RAGDOLL_FLAGS) do
		if c:GetAttribute(n) == true or h:GetAttribute(n) == true or player:GetAttribute(n) == true then
			return "attribute " .. n
		end
		local v = c:FindFirstChild(n)
		if v and v:IsA("BoolValue") and v.Value then return "BoolValue " .. n end
	end
	return nil
end

-- Waits until the character is free (not ragdolled / dead) for RAGDOLL_SETTLE seconds in a row.
-- Returns false only if the farm is paused, the given feature is switched off, or the timeout is hit.
local function waitReady(timeout, feature)
	local t0 = os.clock()
	local announced = false
	local freeSince = nil
	while true do
		if not settings.master then return false end
		if feature and not settings[feature] then return false end

		local c, h = getChar()
		local why = "no character"
		if c then why = ragdollReason(c, h) end

		if why then
			freeSince = nil
			if not announced then
				log("INFO", "Waiting, can't act:", why)
				announced = true
			end
		else
			freeSince = freeSince or os.clock()
			if os.clock() - freeSince >= C.RAGDOLL_SETTLE then
				if announced then log("INFO", string.format("Free again after %.2fs", os.clock() - t0)) end
				return true
			end
		end

		if os.clock() - t0 >= timeout then
			log("WARN", string.format("waitReady timed out after %.1fs", timeout))
			return false
		end
		task.wait()
	end
end

local function teleportTo(cf, feature)
	if not waitReady(C.RAGDOLL_TIMEOUT, feature) then
		log("DBG", "Teleport skipped (paused / feature off)")
		return false
	end
	local c, _, r = getChar()
	if not c then return false end
	c:PivotTo(cf)
	r.AssemblyLinearVelocity = Vector3.zero
	r.AssemblyAngularVelocity = Vector3.zero
	return true
end

