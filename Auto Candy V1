-- drag (eased, so it glides instead of snapping to the cursor)
local panelPos = Vector2.zero    -- current offset from screen center (px)
local panelTarget = Vector2.zero -- where the drag wants it to be

local function clampPanel(v)
	local vs = gui.AbsoluteSize
	local half = Vector2.new(205, 280)
	-- keep the title bar reachable so it can never get lost off-screen
	local minX, maxX = -(vs.X / 2 + half.X - 100), (vs.X / 2 + half.X - 100)
	local minY, maxY = half.Y - vs.Y / 2, vs.Y / 2 - 64 + half.Y
	return Vector2.new(math.clamp(v.X, minX, maxX), math.clamp(v.Y, minY, maxY))
end

do
	local dragging, dragInput, dragStart, startTarget = false, nil, nil, nil
	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInput = input
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startTarget = panelTarget
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput then
			local d = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			panelTarget = clampPanel(startTarget + d)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end

-- menu open / close
local menuOpen = false
local saved = nil

local function setMenu(open)
	if open == menuOpen then return end
	menuOpen = open
	if open then
		saved = { behavior = UIS.MouseBehavior, icon = UIS.MouseIconEnabled }
		local ps = player:FindFirstChild("PlayerScripts")
		local fp = ps and ps:FindFirstChild("FirstPersonCamera")
		if fp and fp:IsA("LocalScript") and not fp.Disabled then
			saved.fp = fp
			fp.Disabled = true
		end
		pcall(function() RunService:UnbindFromRenderStep("CandyFarmMouse") end)
		RunService:BindToRenderStep("CandyFarmMouse", Enum.RenderPriority.Camera.Value + 10, function()
			UIS.MouseBehavior = Enum.MouseBehavior.Default
			UIS.MouseIconEnabled = true
		end)
		panel.Visible = true
		panel.GroupTransparency = 1
		panelScale.Scale = 0.82
		TweenService:Create(panel, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { GroupTransparency = 0 }):Play()
		TweenService:Create(panelScale, POP, { Scale = 1 }):Play()
		renderAll()
	else
		pcall(function() RunService:UnbindFromRenderStep("CandyFarmMouse") end)
		if saved then
			if saved.fp then saved.fp.Disabled = false end
			UIS.MouseBehavior = saved.behavior
			UIS.MouseIconEnabled = saved.icon
			saved = nil
		end
		TweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { GroupTransparency = 1 }):Play()
		TweenService:Create(panelScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { Scale = 0.9 }):Play()
		task.delay(0.22, function()
			if not menuOpen then panel.Visible = false end
		end)
	end
end

local function updateStatus()
	local anyOn = settings.candy or settings.tree or settings.pinata or settings.zombie
	if not settings.master then
		status.Text = "[" .. C.TOGGLE_KEY.Name .. "] Farm: PAUSED"
		status.TextColor3 = SILVER
	elseif anyOn then
		status.Text = "[" .. C.TOGGLE_KEY.Name .. "] Farm: RUNNING"
		status.TextColor3 = Color3.fromRGB(255, 110, 125)
	else
		status.Text = "[" .. C.TOGGLE_KEY.Name .. "] Farm: ON (nothing enabled)"
		status.TextColor3 = SILVER
	end
end

