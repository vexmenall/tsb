-- floating ember particles (pooled + driven every frame so the motion is smooth)
local PARTICLE_COLORS = {
	Color3.fromRGB(255, 60, 80),
	Color3.fromRGB(255, 120, 60),
	Color3.fromRGB(255, 190, 90),
	Color3.fromRGB(200, 60, 230),
	Color3.fromRGB(255, 100, 170),
	Color3.fromRGB(170, 25, 45),
}
local rng = Random.new()
local fxList = {}

local function makeFX(layer, maxCount, rate, gate)
	local fx = { layer = layer, pool = {}, live = {}, acc = 0, rate = rate, gate = gate }
	for _ = 1, maxCount do
		local p = Instance.new("Frame")
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.BorderSizePixel = 0
		p.BackgroundTransparency = 1
		p.Visible = false
		p.ZIndex = 2
		p.Parent = layer
		addCorner(p, 99)
		table.insert(fx.pool, p)
	end
	table.insert(fxList, fx)
	return fx
end

local function updateFX(fx, dt)
	if fx.gate and not fx.gate() then return end
	local h = fx.layer.AbsoluteSize.Y
	if h <= 0 then return end

	fx.acc = math.min(fx.acc + dt * fx.rate, 3)
	while fx.acc >= 1 and #fx.pool > 0 do
		fx.acc -= 1
		local p = table.remove(fx.pool)
		p.BackgroundColor3 = PARTICLE_COLORS[rng:NextInteger(1, #PARTICLE_COLORS)]
		p.Visible = true
		table.insert(fx.live, {
			f = p,
			x = rng:NextNumber(0.03, 0.97),
			speed = rng:NextNumber(h * 0.16, h * 0.42),
			sway = rng:NextNumber(3, 9),
			freq = rng:NextNumber(0.8, 1.8),
			phase = rng:NextNumber(0, 6.28),
			age = 0,
			life = rng:NextNumber(3.2, 5.5),
			size = rng:NextInteger(3, 7),
			base = rng:NextNumber(0.05, 0.35),
		})
	end

	for i = #fx.live, 1, -1 do
		local s = fx.live[i]
		s.age += dt
		local a = s.age / s.life
		local y = h + 6 - s.speed * s.age
		if a >= 1 or y < -8 then
			s.f.Visible = false
			s.f.BackgroundTransparency = 1
			table.insert(fx.pool, s.f)
			table.remove(fx.live, i)
		else
			local alpha = math.min(1, a / 0.15, (1 - a) / 0.45)
			alpha = alpha * alpha * (3 - 2 * alpha) -- smoothstep
			local k = 0.55 + 0.45 * (1 - a)
			s.f.Position = UDim2.new(s.x, math.sin(s.age * s.freq * 2 + s.phase) * s.sway, 0, y)
			s.f.Size = UDim2.fromOffset(s.size * k, s.size * k)
			s.f.BackgroundTransparency = 1 - alpha * (1 - s.base)
		end
	end
end

