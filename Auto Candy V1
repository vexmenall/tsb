-- ====== LOGGING =====================================================
-- ====================================================================
local history = {}
local uiAdd = nil

local function log(level, ...)
	if level == "DBG" and not settings.verbose then return end
	local parts = table.pack(...)
	for i = 1, parts.n do parts[i] = tostring(parts[i]) end
	local msg = table.concat(parts, " ")
	local line = string.format("[CandyFarm][%7.2f][%s] %s", os.clock() - T0, level, msg)
	if level == "WARN" or level == "ERR" then warn(line) else print(line) end
	local entry = { t = os.clock() - T0, level = level, msg = msg }
	table.insert(history, entry)
	if #history > 200 then table.remove(history, 1) end
	if uiAdd then uiAdd(entry) end
end

